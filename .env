# Server Settings
APP_ENV=development
USE_MOCK_WHATSAPP=true

# Meta WhatsApp Cloud API Credentials
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_permanent_system_user_token_here
WHATSAPP_VERIFY_TOKEN=vendly_secret_verify_token

# Local Webhook Callback target for Mock Client
LOCAL_WEBHOOK_URL=http://127.0.0.1:8000/api/v1/webhook/whatsapp